# Required by the server for interpretation and planning.
OPENROUTER_API_KEY=

# Optional server configuration.
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
PORT=3001

# Optional frontend API base URL.
# Leave empty for same-origin production requests and the Vite dev proxy.
VITE_API_URL=

# Legacy alias accepted by the frontend:
# VITE_API_BASE_URL=
